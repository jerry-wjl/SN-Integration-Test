---
# ==============================================================================
# PLAY 1: 虚拟机克隆、网络强制连接与 WinRM 激活 (运行于 localhost)
# ==============================================================================
- name: "Standalone VMware Guest Provision and WinRM Setup"
  hosts: localhost
  gather_facts: false
  collections:
    - community.vmware
  vars_files:
    - poc_config.yml

  tasks:
    - name: "Step 1: Cloning and Provisioning VMs"
      community.vmware.vmware_guest:
        hostname: "{{ lookup('env', 'VMWARE_HOST') }}"
        username: "{{ lookup('env', 'VMWARE_USER') }}"
        password: "{{ lookup('env', 'VMWARE_PASSWORD') }}"
        validate_certs: false
        datacenter: "{{ infra_config.vcenter_dc }}"
          #cluster: "{{ infra_config.vcenter_cluster }}"
        datastore: "{{ infra_config.vcenter_ds }}"
        folder: "{{ infra_config.vm_folder }}"
        template: "{{ infra_config.vm_template }}"
        name: "{{ vm_item.name }}"   # 统一修正为 vm_item
        state: powered-on
        hardware:
          memory_mb: "{{ vm_item.ram }}"
          num_cpus: "{{ vm_item.cpu }}"
        customization:
          password: "{{ win_connection_vars.ansible_password }}"
          autologon: false
          autologoncount: 0
        networks:
          - name: "{{ infra_config.vm_network }}"
            ip: "{{ vm_item.ip }}"
            netmask: "{{ vm_item.mask }}"
            gateway: "{{ vm_item.gw }}"
            dns_servers: "{{ vm_item.dns }}"
            type: static
            start_connected: true
            connected: true
              # device_type: vmxnet3
        wait_for_ip_address: no
      loop: "{{ vm_list }}"
      loop_control:
        loop_var: vm_item

    - name: "Step 2: Final OS Initialization Wait"
      ansible.builtin.pause:
        minutes: 3
        prompt: "NIC should be connected now. Giving Windows 3 minutes to finish Sysprep..."

    # --- 加域前：WinRM Reconfigure ---
    - name: "Step 3.1: [Pre-Join] Delete existing default HTTP listener"
      community.vmware.vmware_vm_shell:
        hostname: "{{ lookup('env', 'VMWARE_HOST') }}"
        username: "{{ lookup('env', 'VMWARE_USER') }}"
        password: "{{ lookup('env', 'VMWARE_PASSWORD') }}"
        validate_certs: false
        datacenter: "{{ infra_config.vcenter_dc }}"
        vm_id: "{{ vm_item.name }}"
        vm_username: "{{ win_connection_vars.ansible_user }}"
        vm_password: "{{ win_connection_vars.ansible_password }}"
        vm_shell: "C:\\Windows\\System32\\cmd.exe"
        vm_shell_args: "/c winrm delete winrm/config/listener?Address=*+Transport=HTTP 2>nul & exit 0"
        wait_for_process: true
      loop: "{{ vm_list }}"
      loop_control:
        loop_var: vm_item
      delegate_to: localhost

    - name: "Step 3.2: [Pre-Join] Force change network profile to Private"
      community.vmware.vmware_vm_shell:
        hostname: "{{ lookup('env', 'VMWARE_HOST') }}"
        username: "{{ lookup('env', 'VMWARE_USER') }}"
        password: "{{ lookup('env', 'VMWARE_PASSWORD') }}"
        validate_certs: false
        datacenter: "{{ infra_config.vcenter_dc }}"
        vm_id: "{{ vm_item.name }}"
        vm_username: "{{ win_connection_vars.ansible_user }}"
        vm_password: "{{ win_connection_vars.ansible_password }}"
        vm_shell: "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
        vm_shell_args: "-Command \"Get-NetConnectionProfile | ForEach-Object { Set-NetConnectionProfile -InterfaceIndex $_.InterfaceIndex -NetworkCategory Private }\""
        wait_for_process: true
      loop: "{{ vm_list }}"
      loop_control:
        loop_var: vm_item
      delegate_to: localhost

    - name: "Step 3.3.1: Read local winrm_config.reg content from Project directory"
      ansible.builtin.set_fact:
        reg_file_content: "{{ lookup('file', './winrm_config.reg') }}"

#    - name: "Step 3.3: [Pre-Join] Inject Local Group Policy via Registry File"
#      community.vmware.vmware_vm_shell:
#        hostname: "{{ lookup('env', 'VMWARE_HOST') }}"
#        username: "{{ lookup('env', 'VMWARE_USER') }}"
#        password: "{{ lookup('env', 'VMWARE_PASSWORD') }}"
#        validate_certs: false
#        datacenter: "{{ infra_config.vcenter_dc }}"
#        vm_id: "{{ vm_item.name }}"
#        vm_username: "{{ win_connection_vars.ansible_user }}"
#        vm_password: "{{ win_connection_vars.ansible_password }}"
#        # --- 核心改动：切换到 PowerShell 解释器 ---
#        vm_shell: "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
#        # --- 核心命令替换：利用 Here-String 强行在虚机内生成 reg 文件并导入 ---
#        vm_shell_args: >-
#          -Command "$content = @'
#          {{ reg_file_content }}
#          '@; [System.IO.File]::WriteAllText('C:\Windows\Temp\winrm_config.reg', $content, [System.Text.Encoding]::UTF8); reg import C:\Windows\Temp\winrm_config.reg"
#        wait_for_process: true
#      loop: "{{ vm_list }}"
#      loop_control:
#        loop_var: vm_item
#      delegate_to: localhost

#    - name: "Step 3.3: [Pre-Join] Inject Local Group Policy via PowerShell Registry Command"
#      community.vmware.vmware_vm_shell:
#        hostname: "{{ lookup('env', 'VMWARE_HOST') }}"
#        username: "{{ lookup('env', 'VMWARE_USER') }}"
#        password: "{{ lookup('env', 'VMWARE_PASSWORD') }}"
#        validate_certs: false
#        datacenter: "{{ infra_config.vcenter_dc }}"
#        vm_id: "{{ vm_item.name }}"
#        vm_username: "{{ win_connection_vars.ansible_user }}"
#        vm_password: "{{ win_connection_vars.ansible_password }}"
#        vm_shell: "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
#        vm_shell_args: >-
#          -Command "$path = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\WinRM\Service';
#          if (-not (Test-Path $path)) { New-Item -Path $path -Force };
#          New-ItemProperty -Path $path -Name 'DisableRunAs' -PropertyType DWord -Value 1 -Force;
#          New-ItemProperty -Path $path -Name 'AllowBasic' -PropertyType DWord -Value 1 -Force;
#          New-ItemProperty -Path $path -Name 'AllowUnencryptedTraffic' -PropertyType DWord -Value 1 -Force;"
#        wait_for_process: true
#      loop: "{{ vm_list }}"
#      loop_control:
#        loop_var: vm_item
#      delegate_to: localhost
#
#   - name: "Step 3.3: [Pre-Join] Inject Local Group Policy via Registry File (Fixed Syntax)"
      community.vmware.vmware_vm_shell:
        hostname: "{{ lookup('env', 'VMWARE_HOST') }}"
        username: "{{ lookup('env', 'VMWARE_USER') }}"
        password: "{{ lookup('env', 'VMWARE_PASSWORD') }}"
        validate_certs: false
        datacenter: "{{ infra_config.vcenter_dc }}"
        vm_id: "{{ vm_item.name }}"
        vm_username: "{{ win_connection_vars.ansible_user }}"
        vm_password: "{{ win_connection_vars.ansible_password }}"
        vm_shell: "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
        # 使用 | 确保每一步都换行，严格满足 Here-String 的格式要求
        vm_shell_args: |
          -Command "$content = @'
          {{ reg_file_content }}
          '@
          [System.IO.File]::WriteAllText('C:\Windows\Temp\winrm_config.reg', $content, [System.Text.Encoding]::UTF8)
          reg import C:\Windows\Temp\winrm_config.reg"
        wait_for_process: true
      loop: "{{ vm_list }}"
      loop_control:
        loop_var: vm_item
      delegate_to: localhost

    - name: "Step 3.4: [Pre-Join] Force refresh GPO and re-create WinRM listener"
      community.vmware.vmware_vm_shell:
        hostname: "{{ lookup('env', 'VMWARE_HOST') }}"
        username: "{{ lookup('env', 'VMWARE_USER') }}"
        password: "{{ lookup('env', 'VMWARE_PASSWORD') }}"
        validate_certs: false
        datacenter: "{{ infra_config.vcenter_dc }}"
        vm_id: "{{ vm_item.name }}"
        vm_username: "{{ win_connection_vars.ansible_user }}"
        vm_password: "{{ win_connection_vars.ansible_password }}"
        vm_shell: "C:\\Windows\\System32\\cmd.exe"
        vm_shell_args: "/c gpupdate /force && winrm quickconfig -q"
        wait_for_process: true
      loop: "{{ vm_list }}"
      loop_control:
        loop_var: vm_item
      delegate_to: localhost

    - name: "Step 3.5: [Pre-Join] Restart WinRM Service"
      community.vmware.vmware_vm_shell:
        hostname: "{{ lookup('env', 'VMWARE_HOST') }}"
        username: "{{ lookup('env', 'VMWARE_USER') }}"
        password: "{{ lookup('env', 'VMWARE_PASSWORD') }}"
        validate_certs: false
        datacenter: "{{ infra_config.vcenter_dc }}"
        vm_id: "{{ vm_item.name }}"
        vm_username: "{{ win_connection_vars.ansible_user }}"
        vm_password: "{{ win_connection_vars.ansible_password }}"
        vm_shell: "C:\\Windows\\System32\\cmd.exe"
        vm_shell_args: "/c net stop WinRM && net start WinRM"
        wait_for_process: true
      loop: "{{ vm_list }}"
      loop_control:
        loop_var: vm_item
      delegate_to: localhost

    - name: "Step 4: Dynamically build temporary inventory with Basic parameters"
      ansible.builtin.add_host:
        name: "{{ item.ip }}"
        groups: "new_windows_hosts"
        ansible_host: "{{ item.ip }}"
        ansible_connection: "winrm"
        ansible_port: 5985
        ansible_winrm_transport: "basic"
        ansible_winrm_server_cert_validation: "ignore"
        ansible_user: "{{ win_connection_vars.ansible_user }}"
        ansible_password: "{{ win_connection_vars.ansible_password }}"
      loop: "{{ vm_list }}"


# ==============================================================================
# PLAY 2: 远程连接 Windows 执行加域与重启 (5985 Basic)
# ==============================================================================
- name: "Windows Active Directory Domain Join Phase"
  hosts: new_windows_hosts
  gather_facts: no
  become: no
  vars_files:
    - poc_config.yml

  tasks:
    - name: "Check WinRM Connectivity via 5985 Basic"
      ansible.windows.win_ping:

    - name: "Join Windows Domain"
      microsoft.ad.membership:
        dns_domain_name: "{{ ad_domain.name }}"
        domain_admin_user: "{{ ad_domain.admin_user }}"
        domain_admin_password: "{{ ad_domain.admin_password }}"
        state: domain
      register: domain_join_results

    - name: "Reboot after Domain Join"
      ansible.windows.win_reboot:
        msg: "Rebooting to finalize domain join"
        pre_reboot_delay: 5
      when: domain_join_results.reboot_required


# ==============================================================================
# PLAY 3: 【终极验证】直接进系统检查加域状态
# ==============================================================================
- name: "Final Domain Verification via Dynamic Connection"
  hosts: new_windows_hosts
  gather_facts: no
  become: no
  vars_files:
    - poc_config.yml

  tasks:
    - name: "Verify Final Connection"
      ansible.windows.win_ping:

    - name: "Verify Domain Membership on Windows"
      ansible.windows.win_shell: |
        (Get-WmiObject -Class Win32_ComputerSystem).PartOfDomain
      register: domain_check

    - name: "Final Dynamic Success Output"
      ansible.builtin.debug:
        msg: "Perfect! VM {{ inventory_hostname }} successfully processed. AD domain validation output: {{ domain_check.stdout }}"

